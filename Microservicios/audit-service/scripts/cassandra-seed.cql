-- =============================================================
-- SEED Cassandra — audit-service  (keyspace: pictorial_arcane)
-- Consistente con core-service/data.sql:
--   billing_by_month  = ventas APPROVED y sus montos
--   artwork_status_history = transiciones de estado de cada obra vendida/reservada
--   security_log_by_event = inicios de sesión de los usuarios del seed
-- Ejecutar:  cqlsh -k pictorial_arcane -f cassandra-seed.cql   (o desde la consola de Astra)
-- =============================================================

USE pictorial_arcane;

CREATE TABLE IF NOT EXISTS artwork_status_history (
  artwork_id bigint,
  changed_at timestamp,
  change_id uuid,
  artwork_name text,
  changed_by bigint,
  created_at timestamp,
  new_status text,
  old_status text,
  reason text,
  PRIMARY KEY ((artwork_id), changed_at, change_id)
) WITH CLUSTERING ORDER BY (changed_at DESC, change_id DESC);

CREATE TABLE IF NOT EXISTS billing_by_month (
  year_month text,
  sale_date date,
  sale_id bigint,
  admin_dni bigint,
  artwork_id bigint,
  client_dni bigint,
  created_at timestamp,
  description text,
  modified_at timestamp,
  profit_amount double,
  profit_percentage double,
  sale_price double,
  sale_status text,
  shipping_address text,
  shipping_status text,
  tax_amount double,
  total_paid double,
  PRIMARY KEY ((year_month), sale_date, sale_id)
) WITH CLUSTERING ORDER BY (sale_date DESC, sale_id DESC);

CREATE TABLE IF NOT EXISTS security_log_by_event (
  event_type text,
  event_date date,
  event_time timestamp,
  event_id uuid,
  admin_dni bigint,
  client_dni bigint,
  details text,
  ip_address inet,
  session_id text,
  PRIMARY KEY ((event_type, event_date), event_time, event_id)
) WITH CLUSTERING ORDER BY (event_time DESC, event_id DESC);

