// ---- Géneros ----
CREATE (:Genre {id: 0, name: "Impresionismo", description: "Captura de la luz y el instante mediante pinceladas sueltas."});
CREATE (:Genre {id: 1, name: "Realismo", description: "Representación fiel y objetiva de la realidad cotidiana."});
CREATE (:Genre {id: 2, name: "Surrealismo", description: "Imágenes oníricas y asociaciones del subconsciente."});
CREATE (:Genre {id: 3, name: "Arte Abstracto", description: "Formas, colores y líneas sin representación figurativa."});
CREATE (:Genre {id: 4, name: "Cubismo", description: "Descomposición geométrica de las formas en múltiples planos."});
CREATE (:Genre {id: 5, name: "Expresionismo", description: "Distorsión emocional de la realidad para transmitir sentimientos."});
CREATE (:Genre {id: 6, name: "Barroco", description: "Dramatismo, contraste y ornamentación exuberante."});
CREATE (:Genre {id: 7, name: "Arte Contemporáneo", description: "Producción artística actual y experimental."});
CREATE (:Genre {id: 8, name: "Pop Art", description: "Iconografía de la cultura popular y de masas."});
CREATE (:Genre {id: 9, name: "Minimalismo", description: "Reducción a lo esencial: simplicidad y geometría."});

